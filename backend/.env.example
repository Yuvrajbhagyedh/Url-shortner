# Copy this file to `.env` and fill in real values.
# For a zero-service local run (SQLite + fakeredis + inline Celery), set:
#   SHORTX_LOCAL=1
#   DATABASE_URL=sqlite+pysqlite:///./shortx.db

# Enables the offline local mode (no Postgres/Redis/Celery needed).
SHORTX_LOCAL=1

# Database. Local: SQLite. Production: PostgreSQL, e.g.
#   postgresql+psycopg2://user:password@host:5432/shortx
DATABASE_URL=sqlite+pysqlite:///./shortx.db

# Redis (production only; ignored in SHORTX_LOCAL mode)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth — CHANGE THIS to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# The public origin used to build short links. Production: your real domain,
# e.g. https://sho.rt
BASE_URL=http://localhost:8000

# Comma-separated allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
